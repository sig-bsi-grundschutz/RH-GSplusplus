        "control-implementations": [
          {
            "uuid": "f91370c2-11d0-5ae8-8392-eb381ba37661",
            "source": "trestle://profiles/rhel9-gsplusplus-host/profile.json",
            "description": "Grundschutz++-Anforderungen, umgesetzt durch RHEL-Systemhärtung und Konfiguration (Artefakt rhel9-gsplusplus-host).",
            "implemented-requirements": [
              {
                "uuid": "74907933-c4ea-5a08-82fd-4d902ea4934a",
                "control-id": "KONF.2.1",
                "description": "RHEL liefert die technischen Bausteine, aus denen eine Institution eine Grundkonfiguration ableiten und reproduzierbar ausrollen kann: Anaconda/Kickstart und Image Builder-Blueprints erzeugen definierte Installationszustände, chronyd steuert Zeitsynchronisation, NetworkManager/SSSD/realmd binden DNS- und Verzeichnisdienste ein, und scap-security-guide stellt vorgefertigte Härtungsprofile (z. B. BSI, CIS) bereit, die per OpenSCAP oder Ansible auf ein System angewendet werden. Red Hat Insights (im verbundenen Umgebungen) oder Red Hat Satellite (in disconnected / air-gapped Umgebungen) vergleicht mittels OpenSCAP laufende Systeme gegen bekannte Best-Practice- und Compliance-Regelsätze und aggregiert Abweichungen. Welche Einstellungen konkret als verbindliche Referenz gelten, welches Benchmark (BSI, CIS) zugrunde gelegt wird und wie die Freigabe der Grundkonfiguration organisatorisch erfolgt, legt die Institution jedoch selbst fest; RHEL erzwingt keine bestimmte Baseline.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "partial",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd"
                  }
                ]
              },
              {
                "uuid": "f2ecb0da-fd50-5baa-9d9b-1bbfe078225a",
                "control-id": "KONF.2.1.1",
                "description": "Konfigurationsartefakte auf RHEL (Pakete, /etc, Kickstart, Ansible-Inventar) lassen sich in Versionsverwaltung und Change-Prozesse einbinden. Der organisationsweite Versionsprozess obliegt der Institution.",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "partial",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd"
                  }
                ]
              },
              {
                "uuid": "ef97fa55-1c53-5feb-87b7-8a54c03a72bd",
                "control-id": "KONF.2.2",
                "description": "RHEL System-wide Crypto Policies (/etc/crypto-policies) steuern zulässige kryptographische Verfahren für Dienste; die Institution wählt das passende Profil (z. B. DEFAULT, FIPS:OSPP).",
                "props": [
                  {
                    "name": "implementation-status",
                    "value": "partial",
                    "ns": "https://oscal-compass.github.io/compliance-trestle/schemas/oscal/cd"
                  }
