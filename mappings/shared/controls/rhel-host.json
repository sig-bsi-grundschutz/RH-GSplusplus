      "statement": "RHEL auditd kann Erfolg und Fehlschlag von Authentisierungen protokollieren, wenn Audit-Regeln gemäß Produktdokumentation und scap-security-guide-Baselines konfiguriert sind."
    },
    "DET.3.1.2": {
      "component": "rhel-audit",
      "tier": 2,
      "implementation_status": "partial",
